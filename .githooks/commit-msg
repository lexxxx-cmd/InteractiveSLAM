#!/bin/sh
# ============================================================================
# commit-msg hook —— 提交信息格式强制校验
#
# 规则：
#   1. 标题必须为  <type>(<scope>): <描述>
#      type 限定: feat fix refactor perf i18n docs build test chore
#      scope 可选: 小写字母/数字/下划线/连字符
#   2. 标题与正文之间必须有空行
#   3. 正文必须包含「背景问题」与「解决方式」两段
#
# 用法：git commit 时由 git 自动调用，格式不合法则拒绝提交。
# ============================================================================

MSG_FILE="$1"
[ -f "$MSG_FILE" ] || { echo "commit-msg: cannot read message file" >&2; exit 1; }

MSG=$(cat "$MSG_FILE")

# ---- 1. 标题格式 ----
TITLE=$(printf '%s\n' "$MSG" | sed -n '1p')
if ! printf '%s\n' "$TITLE" | grep -qE '^(feat|fix|refactor|perf|i18n|docs|build|test|chore)(\([a-z0-9_-]+\))?: .+$'; then
    echo "ERROR: commit title must match '<type>(<scope>): <描述>'" >&2
    echo "  allowed types: feat | fix | refactor | perf | i18n | docs | build | test | chore" >&2
    echo "  examples:" >&2
    echo "    fix(render): 数组池复用后补 dirty()，修复重建后点云不更新" >&2
    echo "    i18n: 补齐 Bag 导入弹窗的中文翻译" >&2
    exit 1
fi

# ---- 2. 标题与正文之间必须有空行 ----
SECOND=$(printf '%s\n' "$MSG" | sed -n '2p')
if [ -n "$SECOND" ]; then
    echo "ERROR: blank line required between title and body" >&2
    echo "  format:" >&2
    echo "    <type>(<scope>): <描述>" >&2
    echo "    " >&2
    echo "    背景问题：..." >&2
    echo "    解决方式：..." >&2
    exit 1
fi

# ---- 3. 正文必须包含「背景问题」与「解决方式」 ----
if ! printf '%s\n' "$MSG" | grep -q '背景问题'; then
    echo "ERROR: body must contain a '背景问题：...' paragraph" >&2
    exit 1
fi
if ! printf '%s\n' "$MSG" | grep -q '解决方式'; then
    echo "ERROR: body must contain a '解决方式：...' paragraph" >&2
    exit 1
fi

exit 0
